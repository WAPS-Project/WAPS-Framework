{
	"name": "waps/framework",
	"description": "Ein modernes PHP-Framework mit PSR-4 Autoloading",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "WAPS Team",
			"email": "info@waps-framework.info"
		}
	],
	"require": {
		"php": ">=8.0",
		"twig/twig": "^3.21"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0"
	},
	"autoload": {
		"psr-4": {
			"Waps\\Framework\\": "src/Waps/Framework/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Waps\\Framework\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "stable"
}
